+    vert = cv2.morphologyEx(bw, cv2.MORPH_OPEN, cv2.getStructuringElement(cv2.MORPH_RECT, (1, sh // 10)))
+    bw = cv2.subtract(bw, cv2.bitwise_or(horiz, vert))
+    bw = cv2.morphologyEx(bw, cv2.MORPH_OPEN, cv2.getStructuringElement(cv2.MORPH_RECT, (2, 2)))
+
+    # Ignore scanner edges / page-bleed borders
+    bx, by = int(sw * 0.02), int(sh * 0.02)
+    bw[:by, :] = 0; bw[-by:, :] = 0; bw[:, :bx] = 0; bw[:, -bx:] = 0
+
+    # Drop isolated specks (dust, scanner noise) so they cannot stretch a line's box sideways
+    n_cc, labels, stats, _ = cv2.connectedComponentsWithStats(bw, connectivity=8)
+    for ci in range(1, n_cc):
+        if stats[ci, cv2.CC_STAT_AREA] < 18:
+            bw[labels == ci] = 0
+
+    # Merge letters into line-shaped blobs, then project rows
+    merged = cv2.dilate(bw, cv2.getStructuringElement(cv2.MORPH_RECT, (35, 3)))
+    row_ink = (merged > 0).sum(axis=1).astype(float)
+    thresh = max(6.0, sw * 0.012)
+    active = row_ink > thresh
+
+    min_h = max(6, int(sh * min_line_height_frac))
+    lines, start = [], None
+    for y, on in enumerate(active):
+        if on and start is None:
+            start = y
+        elif not on and start is not None:
+            if y - start >= min_h:
+                lines.append((start, y))
+            start = None
+    if start is not None and sh - start >= min_h:
+        lines.append((start, sh))
+
+    # Merge fragments separated by tiny gaps (i-dots, descenders)
+    merged_lines = []
+    for s, e in lines:
+        if merged_lines and s - merged_lines[-1][1] < sh * 0.006:
+            merged_lines[-1] = (merged_lines[-1][0], e)
+        else:
+            merged_lines.append((s, e))
+
+    # Split oversized blobs: slanted/close handwriting can merge 2-3 lines into one band.
+    # TrOCR only reads a single line well, so cut at the valleys of the ink profile.
+    if len(merged_lines) >= 3:
+        heights = sorted(e - s for s, e in merged_lines)
+        median_h = heights[len(heights) // 2]
+        raw_profile = (bw > 0).sum(axis=1).astype(float)
+        kernel = np.ones(5) / 5.0
+        split_lines = []
+        for s, e in merged_lines:
+            n = int(round((e - s) / float(median_h))) if median_h > 0 else 1
+            if (e - s) > 1.6 * median_h and n >= 2:
+                prof = np.convolve(raw_profile[s:e], kernel, mode="same")
+                seg_h = (e - s) / float(n)
+                cuts = [s]
+                for k in range(1, n):
+                    target = int(s + k * seg_h)
+                    lo = max(cuts[-1] + 2, int(target - seg_h * 0.35))
+                    hi = min(e - 2, int(target + seg_h * 0.35))
+                    if hi <= lo:
+                        cuts.append(target)
+                    else:
+                        cuts.append(lo + int(np.argmin(prof[lo - s:hi - s])))
+                cuts.append(e)
+                split_lines.extend(zip(cuts[:-1], cuts[1:]))
+            else:
+                split_lines.append((s, e))
+        merged_lines = split_lines
+
+    bboxes = []
+    pad = int(sh * pad_frac)
+    for s, e in merged_lines:
+        band = bw[s:e, :]
+        cols = np.where(band.sum(axis=0) > 0)[0]
+        if cols.size == 0:
+            continue
+        x0, x1 = max(0, cols[0] - pad * 2), min(sw, cols[-1] + pad * 2)
+        if (x1 - x0) < sw * 0.025:   # too narrow to be handwriting: margin-rule residue
+            continue
+        y0, y1 = max(0, s - pad), min(sh, e + pad)
+        bboxes.append((round(y0 / sh, 4), round(x0 / sw, 4), round(y1 / sh, 4), round(x1 / sw, 4)))
+    return bboxes
