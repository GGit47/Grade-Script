index 0000000..85cae6b
--- /dev/null
+++ b/backend/app/services/mapping/line_grouper.py
@@ -0,0 +1,86 @@
+import re
+from typing import Any, Dict, List, Optional, Tuple
+
+# A new answer starts when a line begins with a question number followed by a
+# separator, e.g. "21,", "22.", "23)", "Q24", "Ans 25:", "26 -"
+_MARKER = re.compile(
+    r"^\s*[\(\[]?\s*(?:Q(?:uestion)?\.?\s*|Ans(?:wer)?\.?\s*)?(\d{1,3})\s*[\)\]]?\s*[,.:;\-)]\s*",
+    re.IGNORECASE,
+)
+_BARE_Q = re.compile(r"^\s*(?:Q(?:uestion)?|Ans(?:wer)?)\.?\s*(\d{1,3})\b", re.IGNORECASE)
+
+# Page footers like "1/3" or "2 / 3" must never start an answer
+_PAGE_FOOTER = re.compile(r"^\s*\d{1,2}\s*/\s*\d{1,2}\s*\.?\s*$")
+
+
+def detect_question_number(text: str, max_question_number: Optional[int] = None) -> Optional[int]:
+    if not text or _PAGE_FOOTER.match(text):
+        return None
+    m = _MARKER.match(text) or _BARE_Q.match(text)
+    if not m:
+        return None
+    n = int(m.group(1))
+    if n <= 0:
+        return None
+    if max_question_number is not None and n > max_question_number:
+        return None
+    return n
+
+
+def _union(boxes: List[Tuple[float, float, float, float]]) -> Tuple[float, float, float, float]:
+    return (
+        min(b[0] for b in boxes),
+        min(b[1] for b in boxes),
+        max(b[2] for b in boxes),
+        max(b[3] for b in boxes),
+    )
+
+
+def group_lines_into_answers(
+    pages: List[Dict[str, Any]],
+    max_question_number: Optional[int] = None,
+) -> List[Dict[str, Any]]:
+    """
+    pages: [{"page_idx": int, "bboxes": [...], "texts": [...]}, ...] in page order.
+    Returns answer groups: {"page_idx", "bbox", "text", "lines", "question_number"}.
+
+    Lines that precede the first marker on a page are treated as the continuation of the
+    previous answer (an answer that runs over a page break), or as an unlabeled group if
+    there is no previous answer.
+    """
+    groups: List[Dict[str, Any]] = []
+    current: Optional[Dict[str, Any]] = None
+
+    def flush():
+        nonlocal current
+        if current and current["lines"]:
+            current["bbox"] = _union(current["boxes"])
+            current["text"] = "\n".join(current["lines"])
+            del current["boxes"]
+            groups.append(current)
+        current = None
+
+    for page in pages:
+        # Continuation across pages is kept as its own region on the new page,
+        # because a region's crop must belong to a single page image.
+        if current is not None and current["page_idx"] != page["page_idx"]:
+            flush()
+        for bbox, text in zip(page["bboxes"], page["texts"]):
+            if not text or not text.strip():
+                continue
+            if _PAGE_FOOTER.match(text.strip()):
+                continue
+            qn = detect_question_number(text, max_question_number)
+            if qn is not None or current is None:
+                flush()
+                current = {
+                    "page_idx": page["page_idx"],
+                    "question_number": qn,
+                    "lines": [text.strip()],
+                    "boxes": [bbox],
+                }
+            else:
+                current["lines"].append(text.strip())
+                current["boxes"].append(bbox)
+    flush()
+    return groups
